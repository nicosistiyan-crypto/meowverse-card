# Supabase: Project Settings > API
SUPABASE_URL="https://xxxxxxxx.supabase.co"
# service_role key (or the new "secret" key). SERVER ONLY. Never expose it in browser code or commit it.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Username that automatically becomes SUPER_ADMIN when registered / logged in.
# Never put the admin PASSWORD here or in code: you choose it yourself on /register.
ADMIN_USERNAME="your_username"
# Optional: minimum seconds between pack openings per player (0 = unlimited, good for testing)
PACK_COOLDOWN_SECONDS="0"
